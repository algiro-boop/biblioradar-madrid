		if(elem!=null){
			var vis = elem.style; 
			vis.display='none';
		}
		$('contenido_detalle').hide();
	}
	function ocultarEdicionGrupo()
	{
		var elem = $("boton_edicion_grupo");
		if(elem!=null){
			var vis = elem.style; 
			vis.display='none';
		}
	}
</script>


