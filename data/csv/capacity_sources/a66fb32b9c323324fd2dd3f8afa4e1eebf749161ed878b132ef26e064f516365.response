  <div class="paragraph paragraph--type--featured-content paragraph--view-mode--default">
          
<div  class="component-featured-content featured-content"><div class="featured-content-contain full"><div class="featured-content-info"><h3  id="featured-content-heading-34830" class="heading level-h3 bold-1">
  Suscríbete  a las actividades  </h3><div class="field field--name-description-format field--type-text-long field--label-hidden"><p><strong>y recibe&nbsp;la información del día a día de las actividades&nbsp;</strong></p></div></div><div class="featured-content-buttons"><a  href="https://web.comunidad.madrid/glim/?p=subscribe&amp;id=2" role="button" target="_blank" aria-label="Suscríbete" id="featured-content-button-34830" class="btn btn-primary btn-text-icon btn-md"><span>
