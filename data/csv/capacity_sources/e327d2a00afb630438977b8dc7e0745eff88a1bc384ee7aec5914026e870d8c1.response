<script type="text/javascript">	
	function ocultarDetalleGrupo()
	{
		alAbrirCerrarDetalle(true);

		var elem = $("contenedor_detalle");
		if(elem!=null){
			var vis = elem.style; 
			vis.display='none';
		}
		$('contenido_detalle').hide();
	}
	function ocultarEdicionGrupo()
	{
		var elem = $("boton_edicion_grupo");
		if(elem!=null){
			var vis = elem.style; 
			vis.display='none';
		}
	}
</script>

<script type="text/javascript">
// <![CDATA[
function onCheck()
{
	document.formExport.accionSeleccion.value = 'soloseleccionados';
}

function isTodosMarcados()
{
   for (i=0;i<document.formExport.elements.length;i++)
   {
      if(document.formExport.elements[i].type == "checkbox" && document.formExport.elements[i].checked=="0")
	      return "0";
   }
   return "1";
}

function marcarTodos()
{
   for (i=0;i<document.formExport.elements.length;i++)
   {
      if(document.formExport.elements[i].type == "checkbox")
         document.formExport.elements[i].checked=1;
   }
	document.formExport.accionSeleccion.value = 'soloseleccionados';
}

function desmarcarTodos()
{
   for (i=0;i<document.formExport.elements.length;i++)
   {
      if(document.formExport.elements[i].type == "checkbox")
         document.formExport.elements[i].checked=0;
   }
	document.formExport.accionSeleccion.value = 'todos';
}

// ]]>
</script>
