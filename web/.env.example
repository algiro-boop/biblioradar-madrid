# Clave pública "anon" del proyecto Supabase. Nunca uses aquí la service_role.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: teselas XYZ del mapa. Por defecto OpenStreetMap con filtro claro.
# CARTO Positron requiere ahora API key: usa la URL que te da CARTO con tu clave.
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?api_key=TU_CLAVE
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
# Modo oscuro (opcional; sin ella se usa OSM con filtro gris azulado):
# NEXT_PUBLIC_MAP_TILE_URL_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?api_key=TU_CLAVE
